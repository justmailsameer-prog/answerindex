# Cache-Control headers for Answer Index (Cloudflare Pages)

# Static assets: Cache for 1 year with immutable flag
/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
  Access-Control-Allow-Origin: *

# Standard root assets & static icons
/favicon.ico
  Cache-Control: public, max-age=86400, s-maxage=86400

/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=3600

/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=3600

/ai-sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=3600

/sitemap.md
  Cache-Control: public, max-age=3600, s-maxage=3600

# Agentic manifests & AI indices
/llms.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
  Access-Control-Allow-Origin: *

/llms-full.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
  Access-Control-Allow-Origin: *

/ai.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
  Access-Control-Allow-Origin: *

/ai-entities.json
  Cache-Control: public, max-age=3600, s-maxage=3600
  Access-Control-Allow-Origin: *

/ai-intent.json
  Cache-Control: public, max-age=3600, s-maxage=3600
  Access-Control-Allow-Origin: *

/rag-index.json
  Cache-Control: public, max-age=3600, s-maxage=3600
  Access-Control-Allow-Origin: *

# HTML pages: Stale-while-revalidate for fresh deployments and instant edge delivery
/*.html
  Cache-Control: public, max-age=0, must-revalidate
