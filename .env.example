# Environment variables template for AnswerIndex
# Rename this file to .env and fill in your keys:
#
# Linux / macOS:    cp .env.example .env
# Windows (PowerShell): Copy-Item .env.example .env

# 1. Primary AI Benchmark Key (OpenRouter)
# A single OpenRouter API key from https://openrouter.ai/keys will run all benchmark models!
OPENROUTER_API_KEY=

# Target Domain & Brand to benchmark (Optional - can also be passed via CLI)
# Example: npm run benchmark -- example.com "ExampleBrand"
AEO_TARGET_DOMAIN=
AEO_TARGET_BRAND=

# 2. Optional Individual Model Keys (Overrides OPENROUTER_API_KEY if set)
OR_NEMOTRON_3_KEY=
OR_GEMMA_3_27B_KEY=
OR_LLAMA_3_2_KEY=
OR_STEP_3_5_KEY=

# 3. Optional Direct AI Provider Keys (for extended tools)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
